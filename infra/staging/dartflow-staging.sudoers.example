# Render the reviewed helper SHA256, then validate with visudo -cf before installation.
# Runner receives no shell, env, file-install, Caddy or direct systemctl privileges.
run-dart-stg ALL=(root) NOPASSWD: sha256:__REVIEWED_HELPER_SHA256__ /usr/local/libexec/dg-dartflow-deploy-helper ^deploy [a-f0-9]{40} [1-9][0-9]{0\,19}-[1-9][0-9]{0\,9} [A-Za-z0-9][A-Za-z0-9_.-]{0\,95}$
run-dart-stg ALL=(root) NOPASSWD: sha256:__REVIEWED_HELPER_SHA256__ /usr/local/libexec/dg-dartflow-deploy-helper ^rollback [a-f0-9]{12}-[1-9][0-9]{0\,19}-[1-9][0-9]{0\,9}$
