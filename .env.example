# Alleen voor lokale loopback-staging. db:start schrijft willekeurige lokale DB-wachtwoorden.
DARTFLOW_DATA_MODE=local
DARTFLOW_APP_ORIGIN=http://localhost:3000
# Gebruik Postgres 16 server binaries. Alternatief: unprivileged Ubuntu package download.
# DARTFLOW_DOWNLOAD_LOCAL_POSTGRES=1
# DARTFLOW_LOCAL_PG_ROOT=.local/postgres
# DARTFLOW_LOCAL_PG_PORT=55432
# DARTFLOW_PG_BIN=/usr/lib/postgresql/16/bin
# DARTFLOW_DATABASE_URL=postgresql://dartflow_app:...@127.0.0.1:55432/postgres
# DARTFLOW_DATABASE_ADMIN_URL=postgresql://dartflow_owner:...@127.0.0.1:55432/postgres
