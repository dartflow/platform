# Invullen via het bestaande DG-secretbeheer, per omgeving.
# Voorbeeld van variabelen, pas namen aan het aanwezige contract aan.
DARTFLOW_ENV=staging
DARTFLOW_APP_ORIGIN=https://staging.dartflow.example
DARTFLOW_RELEASE_SHA=
NEXT_PUBLIC_SUPABASE_URL=https://STAGING_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DARTFLOW_DATABASE_URL=
# Per omgeving gescopeerd op de eigen Supabase-ref. Alleen server-side.
SUPABASE_MANAGEMENT_TOKEN=
# Runtime encryptiesleutel voor onder andere de appmailcredential. Zie mailhoofdstuk.
DARTFLOW_INTEGRATIONS_ENCRYPTION_KEY=
# De daadwerkelijke Resend API-sleutel wordt door platformbeheer in DartFlow opgeslagen.
# Google Client ID/Secret worden via DartFlow bij Supabase Auth ingesteld.
# SMTP-host, SMTP-key en OTP-template worden door Danny in Supabase ingesteld.
