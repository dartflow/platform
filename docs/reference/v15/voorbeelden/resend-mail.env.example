# Vormvoorbeeld. Vul de serverwaarden via de DG-runtimeconfiguratie.
# Dit voorbeeld is geschikt als beginpunt voor een staging logtransport.

DARTFLOW_ENV=staging
DARTFLOW_APP_ORIGIN=https://<canonieke-staging-host>
DARTFLOW_MAIL_TRANSPORT=log
# Limiet op de ontvangers die de beheerder voor echte testmail kan kiezen.
DARTFLOW_MAIL_TEST_ALLOWLIST=<testmailbox-1>,<testmailbox-2>

# Beschermde waarden per omgeving, nooit NEXT_PUBLIC_.
DARTFLOW_INTEGRATIONS_ENCRYPTION_KEY=<omgevingsgebonden-encryptiesleutel>

# Platformbeheer → Integraties → Resend beheert API-key, webhook signing secret,
# afzendernaam/-adres, Reply-To en testontvangers binnen de runtimegrens.
# De server bewaart beide credentials versleuteld in de private integratietabel.
# Danny beheert Supabase Auth SMTP en OTP-template in het Auth-project.
