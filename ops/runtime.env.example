# Placeholder only. Provision a NEW immutable bundle via the DG administrator.
# /etc/dg-sites/dartflow-staging/configs/<config-id>/runtime.env
# Directory root:root 0700; file root:root 0600. Never overwrite a used bundle.
# The fixed broker accepts only the reviewed server-variable allowlist.
DARTFLOW_DATABASE_URL=postgresql://dartflow_app:<URL-encoded-password>@db.<verified-dartflow-project-ref>.supabase.co:5432/postgres?sslmode=verify-full
DARTFLOW_ENV=staging
# Generate distinct keys ON THE TARGET HOST; these placeholders are not usable values.
DARTFLOW_INTEGRATIONS_ENCRYPTION_KEY=<base64-of-32-random-bytes>
DARTFLOW_MAIL_WORKER_TOKEN=<64-random-hex-characters>
DARTFLOW_MAIL_ALLOWED_FROM=info@example.com
DARTFLOW_MAIL_TEST_RECIPIENTS=owner@example.com
DARTFLOW_MAIL_MAX_MODE=test
DARTFLOW_TURN_SECRET=<base64-of-32-random-bytes-for-this-environment>
DARTFLOW_TURN_URLS=turn:<verified-relay-host>:3478?transport=udp,turn:<verified-relay-host>:3478?transport=tcp
# Optional, server-only scoped credential for exactly this Supabase project:
# SUPABASE_MANAGEMENT_TOKEN=<project-scoped-token>
# DARTFLOW_ADMIN_REQUIRE_MFA=true
# Production uses DARTFLOW_ENV=production, its own keys/ref/relay port and
# DARTFLOW_MAIL_MAX_MODE=live. Stored mail settings still default to log mode.
# A verified session pooler on port 5432 may use dartflow_app.<project-ref>.
# Do not use an administrator, service-role key or another project's credential.
# Put the four public build values in public.json alongside this file; use
# ops/public-config.example.json. The broker generates sealed .release.env itself.
