# NOT a real credential file. Provision through the approved DG control path.
# Host file: /etc/dg-sites/<verified-site-id>/runtime.env, restrictive ownership.
NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=<verified-free-loopback-port>
DARTFLOW_DATA_MODE=supabase
DARTFLOW_APP_ORIGIN=https://staging.dartflow.nl
NEXT_PUBLIC_SUPABASE_URL=https://<staging-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<staging-key>
DARTFLOW_DATABASE_URL=postgresql://<dedicated-app-role>:<url-encoded-secret>@<verified-staging-db-host>:<verified-port>/<database>?sslmode=verify-full
DARTFLOW_RELEASE_SHA=<full-accepted-40-character-source-sha>
# Build the release with matching NEXT_PUBLIC_* values. Changing this runtime file
# does not change values already embedded in the browser bundle.
# The database role has no superuser/BYPASSRLS/DDL rights and no other-project access.
