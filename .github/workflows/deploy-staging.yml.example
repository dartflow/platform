# NOT an active GitHub workflow. This file is deliberately .yml.example.
# Complete host inventory and review the installed DG wrapper before activating.
# Build on the dedicated target runner; the hosted artifact is diagnostic only.
name: Native staging deployment — requires verified DG contract
on:
  workflow_dispatch:
    inputs:
      sha:
        description: Exact SHA accepted by CI
        required: true
        type: string
permissions:
  contents: read
  actions: read
concurrency:
  group: dartflow-native-staging
  cancel-in-progress: false
jobs:
  deploy:
    if: ${{ false }} # Remove only after all gates in ops/deploy-contract.md pass.
    environment: staging
    runs-on: [self-hosted, "<verified-staging-only-label>"]
    timeout-minutes: 30
    steps:
      - name: Contract gate
        run: |
          echo 'Native deploy is not configured. Read ops/deploy-contract.md.' >&2
          exit 78
# The reviewed implementation must validate SHA and successful default-branch CI
# BEFORE any untrusted code reaches this runner, verify host/UID/runner/workspace,
# take host build lock then site lock, create an immutable source snapshot and
# build with the staging values. Invoke only the verified, fixed-site broker.
# No guessed dg-site-deploy flags, sudo rules, Linux accounts, ports or hostnames.
