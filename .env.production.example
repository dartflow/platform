# Public build configuration: GitHub production Variables and protected public.json.
DARTFLOW_APP_ORIGIN=https://dartflow.nl
DARTFLOW_DATA_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=https://wlrnowuownakqqgjxnbb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<production-key>
# Server-only configuration is installed as an immutable runtime.env bundle.
# See ops/runtime.env.example. Never put its secrets in GitHub Variables or NEXT_PUBLIC_*.
# The release chain supplies source/release/config IDs.
# SocialHero server configuration belongs in the separate runtime.env bundle:
# DARTFLOW_SOCIALHERO_ORIGIN=https://your-verified-production-socialhero-host.example.com
# DARTFLOW_SOCIALHERO_SITE_ID=dartflow
# DARTFLOW_ENV=production
# Reuse DARTFLOW_INTEGRATIONS_ENCRYPTION_KEY from production only.
