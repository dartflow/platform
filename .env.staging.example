# Publieke buildconfig: GitHub staging Variables en beschermd public.json.
DARTFLOW_APP_ORIGIN=https://staging.dartflow.nl
DARTFLOW_DATA_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=https://dsnqnvbckkqpzadblshu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<staging-key>
# Server-runtime wordt via een immutable runtime.env-bundel geïnstalleerd.
# Zie ops/runtime.env.example. Geheimen horen niet in GitHub Variables of NEXT_PUBLIC_*.
# DARTFLOW_RELEASE_SHA wordt door de releaseketen aangeleverd, geen handmatige waarde.
# SocialHero serverconfig hoort in de aparte runtime.env-bundel:
# DARTFLOW_SOCIALHERO_ORIGIN=https://socialhero.dgwebservices.nl
# DARTFLOW_SOCIALHERO_SITE_ID=dartflow
# DARTFLOW_ENV=staging
# Hergebruik DARTFLOW_INTEGRATIONS_ENCRYPTION_KEY van uitsluitend staging.
