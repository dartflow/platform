# GitHub Environment variables + beschermd runtimebestand (zelfde waarden).
DARTFLOW_APP_ORIGIN=https://staging.dartflow.nl
DARTFLOW_DATA_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=https://<staging-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<staging-key>
# Uitsluitend server-runtime, via DG-secretbeheer. Geen echte waarde committen.
DARTFLOW_DATABASE_URL=postgresql://dartflow_app:<password>@<staging-db-host>:5432/postgres?sslmode=verify-full
# DARTFLOW_RELEASE_SHA wordt door de releaseketen aangeleverd, geen handmatige waarde.
